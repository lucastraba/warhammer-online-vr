; ---------------------------------------------------------------- mouse pitch lock (phase 7l)
; Ctrl+Shift+Numpad- toggles it: the mouse no longer tilts the view up/down (the headset still does). Heading is unaffected.
;pitch_lock=NUMPAD_SUBTRACT      ; hotkey (Ctrl+Shift+this key)
;pitch_lock_start=off            ; on = start with the lock already on

; ---------------------------------------------------------------- draw distance (phase 7g)
; Multiplies the main camera's far clip plane and the engine's culling far plane. 1.0 (default) = the game's own draw-distance setting,
; 2.0 = twice as far, up to 16. Only what the engine still considers for drawing can appear: if the game fades objects out by its own
; per-object distance, or hides the distance in fog, a bigger number shows nothing more. Start with 2.0 and look at a far horizon.
; (With log=on the report line "DRAW DISTANCE: ... game N -> used M" shows the far plane the game asked for and what was used.)
;draw_distance=1.0
; It works without VR too (flat screen). draw_distance_flat=off limits it to VR mode, as in the original version.
;draw_distance_flat=on

; ---------------------------------------------------------------- logging (phase 7f)
; Logging is OFF by default: no WARVR.log is written and the capture hotkey does nothing. To diagnose a problem set  log=on
; (the file is %TEMP%\WARVR.log). Remove or comment the line to turn it off again.
;log=on

; ---------------------------------------------------------------- ocean / planar water reflection (phase 7f)
; on (default) = the water's reflection map is rendered for the head's orientation and BOTH eyes look it up identically.
; off          = the earlier behaviour (use this if the water looks wrong and send a log with log=on).
;water=on

; Optional. Copy to WARVR.ini next to WARVR.dll. Everything is optional; defaults are shown (commented out).

; ---------------------------------------------------------------- performance (phase 7a)
; gpu_path: send each eye to SteamVR with a pure GPU copy instead of reading the picture back through the CPU.
;   auto = try it, fall back to the CPU path by itself if it cannot work.   off = always use the CPU path.
;gpu_path=auto
; vk_path: only matters with DXVK's d3d9.dll in the game folder INSTEAD of dgVoodoo (experimental, see docs/DXVK.md).
;   The eye pictures then go to SteamVR as Vulkan images, no copy at all. Start SteamVR BEFORE the game.
;   auto = use it when DXVK is detected, fall back to the CPU path by itself.   off = never.
;vk_path=auto
; lazy_state: experimental CPU saving. After each right-eye copy of a world draw the mod normally puts the game's
;   viewport and shader constants back at once (several D3D calls per object). on = only when something needs them,
;   and not at all when the game overwrites them anyway. Compare the PERF lines with it off and on; report odd visuals.
;lazy_state=off
; auto_vr: on = switch VR on by itself once the character is in the world (same as pressing Ctrl+Shift+Numpad *).
;   Meant for test runs and setups where the hotkey does not reach the game.
;auto_vr=off
; vr_snapshot: save the picture the headset receives once, after this many VR frames, as
;   %TEMP%\WARVR_vr_snapshot_<n>.bmp (half size, left half = left eye). 0 = off.
;vr_snapshot=0
;   vr_snapshot=40,3 takes 3 of them, 40 frames apart. vr_snapshot_hud_cycle=on switches to the next HUD style after
;   each one, so one run shows flat, curved and low.
;vr_snapshot_hud_cycle=off
; desktop_every: while in VR the desktop window is NOT presented (saves the blit and, mainly, the wait for your
; monitor's vertical sync, which used to be added to the headset's own wait). 0 = never. N = show every Nth frame
; (you will feel a small hitch on those frames), e.g. 60.
;desktop_every=0

; ---------------------------------------------------------------- VR resolution (phase 7b)
; auto    = (default) the game renders into a target of the size SteamVR recommends (both eyes side by side) as soon as
;           the GPU hand-off is available; otherwise it stays at the game's own resolution (the CPU path would squeeze
;           the picture down to eye_size anyway, so a huge target would be wasted work).
; steamvr = always use SteamVR's size.        desktop = always the game's own resolution.
;vr_resolution=auto
; Pixel budget for BOTH eyes together, in millions. 0 (default) = no budget: SteamVR's exact number, clamped only to what
; the D3D9 device allows (and, if video memory runs out, reduced 10% at a time until it fits - the log says so).
; Example: 5976x6252 per eye is 75 million pixels. Set max_pixels=30 if your frame rate cannot take that.
;max_pixels=0
; Extra multiplier applied after the budget (1.0 = none).
;render_scale=1.0

; ---------------------------------------------------------------- mouse cursor in VR
;cursor=on
; arrow height as a fraction of the HUD height
;cursor_size=0.045

; ---------------------------------------------------------------- VR options
;units_per_meter=32
;eye_size=0
;positional=1
;auto_recenter=0
;cull=on
;steer=camera
;stereo=sbs
;hud=3d
; world (default)  = the HUD is a flat panel hanging in space in front of the GAME camera. It does not follow your head: turn and it
;                    stays put and looks tilted from the side. Recenter (Ctrl+Shift+Numpad /) to bring it in front of you.
; billboard          = anchored the same way but always faces you (cheaper, the phase 7d behaviour).
; head               = locked to the headset (the old behaviour).
;hud_anchor=world
;hud_distance=1.5
;hud_width=2.4
;hud_vertical=0.0
; HUD shape (hud_anchor=world). Try these with the hotkey Ctrl+Shift+H, which cycles flat -> curved -> low while you play.
; flat   (default) = the original flat panel.
; curved           = the same size, bent around you like a cylinder: the edges face you and are as close as the middle,
;                    so the minimap and chat in the corners are easier to read.
; low              = curved, 0.35 m lower and leaned back 20 degrees: more of the world ahead is clear, the HUD is a glance down.
;hud_style=flat
; Laser pointer (VR only; Ctrl+Shift+L toggles it while you play): a red beam along the game's own mouse line,
; ending in a dot on the thing the cursor actually points at. Off by default.
;laser=on
; Where the beam starts: hand (low and to the right) or eyes (from your view: you mostly see just the dot).
;laser_origin=hand
; Beam width in pixels (1-20).
;laser_width=3

; Fine-tuning (after hud_style; any of these makes the style "custom"):
;hud_curve=off
;hud_tilt=0                 (degrees; positive leans the top away from you)
; Lazy follow: the panel stays put while you look around it; when you look more than hud_follow_deg away from its centre
; (for example over your shoulder) it glides after you. off = the original behaviour.
;hud_follow=off
;hud_follow_deg=50

; Split HUD (experimental, VR only; Ctrl+Shift+J toggles it while you play): the minimap, your portrait and bars, and the
; chat are cut out of the board and shown on their own small panels around you, facing you, so they are bigger and easier
; to read at a glance. Everything else (action bars, windows you open) stays on the board. The pieces are read-only for
; now: the mouse still works on the board, so click the minimap or chat where they were before.
;hud_split=on
; The pieces match WAR's default layout. If you moved windows, set your own (the first hud_piece line replaces them all):
;   hud_piece=<name>,<left>,<top>,<right>,<bottom>,<yaw>,<pitch>,<distance>,<width>
; left/top/right/bottom: the rectangle in percent of the game's screen. yaw: degrees to the right (negative = left).
; pitch: degrees up (negative = down). distance and width in metres. The defaults are:
;hud_piece=minimap,87,4.5,100,27.5,28,-6,1.0,0.32
;hud_piece=player,0,0,26,11.5,-20,-22,1.0,0.46
;hud_piece=chat,0,71.5,19.5,100,-32,-8,1.0,0.50
; To find the rectangles: log=on and vr_snapshot=100 save %TEMP%\WARVR_hud_100.bmp, the UI as the game drew it.

; ---------------------------------------------------------------- hotkeys (Ctrl+Shift + key). Defaults shown.
;vr=NUMPAD_MULTIPLY
;recenter=                  (unbound by default; Numpad - is now the mouse pitch lock)
;recenter2=NUMPAD_DIVIDE
;recenter3=OEM_2
;capture=C
;test=NUMPAD_ADD
;head=INSERT
;scale_up=PAGEUP
;scale_down=PAGEDOWN
;cull=HOME
;positional=P
;cursor=M
;hud_near=END
;hud_far=DELETE
;hud_cycle=H
